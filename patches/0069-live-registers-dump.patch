+/* Porthole 0069 (diagnostic): the LIVE guest registers of a running thread. The FEX frame at x28+0x20 is only written back when the JIT code
+ * returns to its dispatcher, so a loop made of indirect jumps never updates it (0052 showed the same registers every sample while the
+ * host registers, mapped as in 0051, kept changing). Host register -> x86: rax x8, rcx x0, rdx x1, rbx x27, rsp x23, rbp fp, rsi x25,
+ * rdi x26, r8-r11 x2-x5, r12-r15 x19-x22. rip is the translated one (ios_native_rip_from_hostpc), flags are the host NZCV. */
+static int ios_live_snapshot( mach_port_t th, uint64_t *g, uint64_t *rip, uint32_t *cpsr, const char **why )
 {
+    extern uint64_t ios_native_rip_from_hostpc( uint64_t, uint64_t, const char ** );
+    arm_thread_state64_t st;
+    mach_msg_type_number_t cnt = ARM_THREAD_STATE64_COUNT;
+    uint64_t bb = 0, pc;
+    static const int map[16] = { 8, 0, 1, 27, 23, -1, 25, 26, 2, 3, 4, 5, 19, 20, 21, 22 };
+    int i;
+
+    if (thread_suspend( th ) != KERN_SUCCESS) return 0;
+    if (thread_get_state( th, ARM_THREAD_STATE64, (thread_state_t)&st, &cnt ) != KERN_SUCCESS) { thread_resume( th ); return 0; }
+    pc = arm_thread_state64_get_pc( st );
+    ios_ts_read( st.__x[28], &bb, 8 );
+    thread_resume( th );
+    for (i = 0; i < 16; i++) g[i] = map[i] < 0 ? st.__fp : st.__x[map[i]];
+    *cpsr = st.__cpsr;
+    *rip = bb > 0x10000 ? ios_native_rip_from_hostpc( bb, pc, why ) : 0;
+    return 1;
+}
