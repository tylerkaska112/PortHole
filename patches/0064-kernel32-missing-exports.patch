--- /dev/null
+++ b/dlls/kernel32/ios_missing_exports.c
@@ -0,0 +1,352 @@
+/*
+ * Porthole 0064: kernel32 exports Windows 10 has and this one lacks.
+ *
+ * Black Ops 3's copy protection looks a kernel32 function up by a hash of its name, walking kernel32's export table, and loops forever when
+ * the name is not exported (the walk found nothing in all 1358 names, `RDI` = NumberOfNames, `RBX`/`R14` = the name and ordinal tables of
+ * kernel32). Every name Windows 10 (1909) exports that ours does not is exported here as a function that reports "not implemented" and
+ * returns 0, and logs its first calls (`[k32-stub] 0064`), which names the one the game is after.
+ */
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(kernel32);
+
+static void ios_k32_stub( const char *name )
+{
+    static LONG calls;
+    LONG n = InterlockedIncrement( &calls );
+    if (n <= 60) ERR( "[k32-stub] 0064 %s called (call %ld)\n", name, n );
+    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+}
+
+#define IOS_K32_STUB(name) DWORD_PTR WINAPI ios_k32_stub_##name(void) { ios_k32_stub( #name ); return 0; }
