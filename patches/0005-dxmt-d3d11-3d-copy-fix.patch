diff --git a/src/d3d11/f4_diag.hpp b/src/d3d11/f4_diag.hpp
new file mode 100644
index 0000000..8c43250
--- /dev/null
+++ b/src/d3d11/f4_diag.hpp
@@ -0,0 +1,10 @@
+#pragma once
+/* f4-0005: rate-limited diagnostics for 3D-texture traffic (dusk/dawn colour-table blend investigation). */
+#include <atomic>
+#include "log/log.hpp"
+#define F4_DIAG(limit, ...)                                                                            \
+  do {                                                                                                 \
+    static std::atomic<unsigned> f4_diag_n{0};                                                         \
+    if (f4_diag_n.fetch_add(1, std::memory_order_relaxed) < (limit))                                   \
+      ERR("[f4-3d] ", __VA_ARGS__);                                                                    \
+  } while (0)
