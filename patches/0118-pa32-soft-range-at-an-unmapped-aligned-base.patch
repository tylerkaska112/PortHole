+/* 0118: an ask the holes cannot serve (no 4GB boundary with a free gigabyte after it) is given a SOFT range at an aligned base whose first 512 MB are unmapped:
+ * nothing is reserved, the guest's commits materialise on demand (ios_soft). V8's second 16 GB ask (hints 16GB-aligned, ten tries, then Chrome's fatal) needs only
+ * this. Bases are searched downwards from below the pool window. */
+static NTSTATUS ios_pa32_soft_far_base( SIZE_T req, uint64_t hint, void **ret )
+{
+    uint64_t align = hint ? (hint & -hint) : 0x100000000ULL, base;
+    unsigned i;
 
+    if (align > 0x400000000ULL) align = 0x400000000ULL;
+    if (align < 0x100000000ULL) align = 0x100000000ULL;
+    if (ios_soft_n >= IOS_SOFT_MAX) return STATUS_NO_MEMORY;
+    for (base = (0x7000000000ULL - req) & ~(align - 1); base >= 0x2000000000ULL; base -= align)
+    {
+        mach_vm_address_t r = base;
+        mach_vm_size_t sz = 0;
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t obj = MACH_PORT_NULL;
+        kern_return_t kr = mach_vm_region( mach_task_self(), &r, &sz, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &cnt, &obj );
+        int taken = 0;
+
+        if (kr == KERN_SUCCESS && r < base + 0x20000000ULL) continue;     /* something is mapped in the first 512 MB */
+        for (i = 0; i < ios_soft_n; i++)
+            if (base < ios_soft[i].base + ios_soft[i].size && base + req > ios_soft[i].base) { taken = 1; break; }
+        if (taken) continue;
+        ios_soft[ios_soft_n].base = base;
+        ios_soft[ios_soft_n].size = req;
+        ios_soft[ios_soft_n].committed = 0;
+        ios_soft[ios_soft_n].commits = 0;
+        ios_soft[ios_soft_n].collisions = 0;
+        ios_soft[ios_soft_n].cage = 0;
+        ios_soft_n++;
+        *ret = (void *)(uintptr_t)base;
+        return STATUS_SUCCESS;
+    }
+    return STATUS_NO_MEMORY;
+}
