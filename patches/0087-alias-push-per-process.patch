+            return;
+        }
+        __atomic_add_fetch(&ios_alias_cbs[slot].pushed, 1, __ATOMIC_RELAXED);
+    }
+    cb(pe, jit, size);
+}
+
+static void ios_alias_cb_clear(void *peb)
+{
+    int i;
+    pthread_mutex_lock( &ios_alias_cbs_lock );
+    for (i = 0; i < IOS_ALIAS_CB_MAX; i++)
+        if (ios_alias_cbs[i].peb == peb)
+        {
+            __atomic_store_n(&ios_alias_cbs[i].peb, NULL, __ATOMIC_RELEASE);   /* key first, as the reclaim of mappings does */
+            __atomic_store_n(&ios_alias_cbs[i].cb, NULL, __ATOMIC_RELEASE);
+        }
+    pthread_mutex_unlock( &ios_alias_cbs_lock );
+}
 
