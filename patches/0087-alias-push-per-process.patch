+/* Porthole 0087: one callback per process.
+ *
+ * ios_jit_alias_pushback_cb above is a single global, replaced by every process that starts an emulator. Once a second x64 process had started (RDR2: the launcher's
+ * service starts while Launcher.exe is still loading libraries), every image the FIRST process mapped afterwards was pushed to the NEWEST process's emulator. The first
+ * process's own emulator never heard of it, FEX could not turn the pool address back into a PE address and refused the entry block ("NoExec instruction in entry block"),
+ * which is a crash for the x64 stubs inside an ARM64EC image (the delay-load stub of d2d1.dll). So each process's callback is also kept here, keyed by its PEB, and an image
+ * mapped by a process is pushed to that process's own emulator as well as to the global one (nothing that used to be delivered is withheld). */
+typedef void (*ios_alias_cb_t)(unsigned long long, unsigned long long, unsigned long long);
+#define IOS_ALIAS_CB_MAX 32
+static struct { void *peb; ios_alias_cb_t cb; int pushed; } ios_alias_cbs[IOS_ALIAS_CB_MAX];
+/* FEX keeps 256 alias entries per emulator and silently refuses the rest (IosAliasEntries FULL), after which the x64 stubs of the refused images cannot run
+ * ("NoExec instruction in entry block", pc=0). Images of OTHER processes are pushed only up to this many; the process's own images always are. */
+#define IOS_ALIAS_FOREIGN_CAP 192
+static pthread_mutex_t ios_alias_cbs_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static ios_alias_cb_t ios_alias_cb_for_peb(void *peb)
+{
+    int i;
+    if (!peb) return NULL;
+    for (i = 0; i < IOS_ALIAS_CB_MAX; i++)
+        if (__atomic_load_n(&ios_alias_cbs[i].peb, __ATOMIC_ACQUIRE) == peb)
+            return __atomic_load_n(&ios_alias_cbs[i].cb, __ATOMIC_ACQUIRE);   /* NULL if it is being cleared */
+    return NULL;
+}
+
+static void ios_alias_cb_set(void *peb, ios_alias_cb_t cb)
+{
+    int i, free_slot = -1;
+    pthread_mutex_lock( &ios_alias_cbs_lock );
+    for (i = 0; i < IOS_ALIAS_CB_MAX; i++)
+    {
+        if (ios_alias_cbs[i].peb == peb) { ios_alias_cbs[i].pushed = 0; __atomic_store_n(&ios_alias_cbs[i].cb, cb, __ATOMIC_RELEASE); free_slot = -2; break; }
