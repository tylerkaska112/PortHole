+    }
+    if (free_slot >= 0)
+    {
+        ios_alias_cbs[free_slot].pushed = 0;
+        __atomic_store_n(&ios_alias_cbs[free_slot].cb, cb, __ATOMIC_RELEASE);   /* callback first: a reader that matches the PEB finds it */
+        __atomic_store_n(&ios_alias_cbs[free_slot].peb, peb, __ATOMIC_RELEASE);
+    }
+    else if (free_slot == -1)
+        dprintf(2, "[alias-push] 0087 per-process callback table FULL (%d) - peb=%p keeps only the shared callback\n", IOS_ALIAS_CB_MAX, peb);
+    pthread_mutex_unlock( &ios_alias_cbs_lock );
+}
+
+/* Push one image to the emulator behind `cb`. `mine` = the process of that emulator mapped it. Foreign images stop at IOS_ALIAS_FOREIGN_CAP so that room is left for its own. */
+static void ios_alias_push_one(ios_alias_cb_t cb, int mine, unsigned long long pe, unsigned long long jit, unsigned long long size)
+{
+    int i, slot = -1;
+    for (i = 0; i < IOS_ALIAS_CB_MAX; i++)
+        if (__atomic_load_n(&ios_alias_cbs[i].cb, __ATOMIC_ACQUIRE) == cb) { slot = i; break; }
+    if (slot >= 0)
+    {
+        int n = __atomic_load_n(&ios_alias_cbs[slot].pushed, __ATOMIC_RELAXED);
+        if (!mine && n >= IOS_ALIAS_FOREIGN_CAP)
+        {
