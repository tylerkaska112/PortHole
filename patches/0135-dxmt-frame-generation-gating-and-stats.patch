+/* 0135: once every two seconds, what happened: the game's pace, how many frames were generated, why the others were not, how long the extra drawable took and what the screen did. */
+static void madeira_fg_stats(uint64_t now, uint32_t numer, uint32_t denom) {
+  if (!g_fg.stat_abs) { g_fg.stat_abs = now; return; }
+  double secs = (double)(now - g_fg.stat_abs) * numer / denom / 1e9;
+  if (secs < 2.0) return;
+  dprintf(STDERR_FILENO, "[framegen] %.1f s: game %.1f fps (frame %.1f ms), generated %.1f/s, skipped: screen too slow %llu, drawables busy %llu, none %llu | "
+          "extra drawable wait avg %.2f max %.1f ms | screen %.1f Hz seen, %.0f asked | in flight now %d, most %d\n",
+          secs, g_fg.stat_frames / secs, g_fg.dt * 1000.0, g_fg.stat_gen / secs, g_fg.skip_rate, g_fg.skip_flight, g_fg.no_drawable,
+          g_fg.acq_n ? g_fg.acq_sum / g_fg.acq_n : 0.0, g_fg.acq_max, g_fg.disp_dt > 0 ? 1.0 / g_fg.disp_dt : 0.0, g_fg.hz > 0 ? g_fg.hz : 0.0,
+          __atomic_load_n(&g_fg.inflight, __ATOMIC_RELAXED), g_fg.inflight_max);
+  g_fg.stat_abs = now; g_fg.stat_frames = 0; g_fg.stat_gen = 0; g_fg.skip_rate = g_fg.skip_flight = 0; g_fg.no_drawable = 0;
+  g_fg.acq_sum = g_fg.acq_max = 0; g_fg.acq_n = 0; g_fg.inflight_max = 0;
+}
+
+/* 0135: a frame this path presented is on its way to the screen; when it is on the screen it no longer holds a drawable of the layer's small pool. */
+static void madeira_fg_track(id<MTLDrawable> d) {
+  int n = __atomic_add_fetch(&g_fg.inflight, 1, __ATOMIC_RELAXED);
+  if (n > g_fg.inflight_max) g_fg.inflight_max = n;
+  [d addPresentedHandler:^(id<MTLDrawable> dd) {
+    __atomic_sub_fetch(&g_fg.inflight, 1, __ATOMIC_RELAXED);
+    double t = dd.presentedTime;
+    if (t > 0) {
+      if (g_fg.last_pt > 0) {
+        double x = t - g_fg.last_pt;
+        if (x > 0.002 && x < 0.1) g_fg.disp_dt = g_fg.disp_dt > 0 ? g_fg.disp_dt * 0.9 + x * 0.1 : x;
+      }
+      g_fg.last_pt = t;
+    }
+  }];
 }
 
