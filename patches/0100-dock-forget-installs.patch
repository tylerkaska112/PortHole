+    /// Porthole 0100: "Run them again". Forgets that this game's install-script programs ever ran (their values leave the prefix's registry files,
+    /// a .madeira-bak copy is kept once) and puts the One-time installs choice back on Run at next start, so the next start runs them all again.
+    /// Only while no session runs (the registry is on disk). Returns how many recorded values were removed.
+    @discardableResult
+    static func forget(_ game: DockGame, drive: URL, prefix: URL) -> Int {
+        let (found, _) = Self.found(game, drive: drive, defaultKey: flag("MADEIRA_INSTALL_DEFAULT_KEY"))
+        var total = 0
+        for (hive, file) in [(SteamInstallRun.Hive.machine, "system.reg"), (.user, "user.reg")] {
+            let runs = found.map(\.run).filter { $0.hive == hive }
+            let registry = prefix.appendingPathComponent(file)
+            guard !runs.isEmpty, let contents = try? Data(contentsOf: registry), !contents.isEmpty else { continue }
+            let (updated, changed) = DockInstallScripts.unmark(runs, in: String(decoding: contents, as: UTF8.self))
+            guard changed > 0 else { continue }
+            let backup = registry.appendingPathExtension("madeira-bak")
+            if !FileManager.default.fileExists(atPath: backup.path) { try? FileManager.default.copyItem(at: registry, to: backup) }
+            do { try Data(updated.utf8).write(to: registry, options: .atomic); total += changed }
+            catch { LogStore.shared.log("[dock-installers] app=\(game.id) could not forget the installs: \(error.localizedDescription)", level: .error) }
+        }
+        setRunsNext(game.id, true, prefix: prefix)
+        LogStore.shared.log("[dock-installers] app=\(game.id) forgot \(total) recorded value(s) of \(found.count) program(s)")
+        return total
+    }
