+/* Porthole 0060 (diagnostic): the code of the program's own unhandled-exception filter (Black Ops 3's answers 0 = continue search for a breakpoint;
+ * on Windows it must handle it). Jump-linked blocks, breadth first, 96 bytes each. */
+static void ios_dump_filter_code( ULONG_PTR start )
+{
+    ULONG_PTR queue[160];
+    unsigned qn = 0, qi = 0, i;
 
+    queue[qn++] = start;
+    while (qi < qn && qi < 140)
+    {
+        unsigned char blk[96]; char row[sizeof(blk) * 2 + 1];
+        ULONG_PTR a = queue[qi++];
+        SIZE_T got = 0;
+        if (NtReadVirtualMemory( GetCurrentProcess(), (void *)a, blk, sizeof(blk), &got ) || got != sizeof(blk)) continue;
+        for (i = 0; i < sizeof(blk); i++) sprintf( row + i * 2, "%02x", blk[i] );
+        ERR( "[uef-dump] 0060 block %p: %s\n", (void *)a, row );
+        for (i = 0; i + 5 <= sizeof(blk); i++)
+        {
+            int off, len;
+            if (blk[i] == 0xe9) { off = 1; len = 5; }
+            else if (blk[i] == 0x0f && i + 6 <= sizeof(blk) && blk[i + 1] >= 0x80 && blk[i + 1] <= 0x8f) { off = 2; len = 6; }
+            else continue;
+            {
+                LONG rel; ULONG_PTR t; unsigned z;
+                memcpy( &rel, blk + i + off, 4 );
+                t = a + i + len + (LONG_PTR)rel;
+                if (t < start - 0x40000000 || t > start + 0x40000000) continue;
+                for (z = 0; z < qn; z++) if (queue[z] == t) break;
+                if (z == qn && qn < ARRAY_SIZE(queue)) queue[qn++] = t;
+            }
+        }
+    }
+}
 
