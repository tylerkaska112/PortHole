+/* 0115: a hole-backed grant (0108/0111/0114) has a REAL part of 1-2 GB and a soft tail the guest believes is reserved. V8 then decommits or protects ranges that cover
+ * both (0.50.228 log: VirtualFree(0x7300000000, 4 GB, MEM_DECOMMIT) -> STATUS_UNABLE_TO_FREE_VM, after which V8 gave the whole reservation up). Clip such a range to the
+ * real view; the soft part has nothing to decommit. Returns 1 and shortens *size when it clipped. */
+static int ios_pa32_clip_to_real( const void *base, SIZE_T *size )
+{
+    struct file_view *v;
+    uint64_t vend, b = (uint64_t)(uintptr_t)base;
+
+    if (!ios_pa32_soft_enabled() || !*size) return 0;
+    if (!(v = find_view( base, 0 ))) return 0;
+    vend = (uint64_t)(uintptr_t)v->base + v->size;
+    if (b >= vend || b + *size <= vend) return 0;
+    if (ios_soft_find( vend ) < 0) return 0;
+    *size = (SIZE_T)(vend - b);
+    return 1;
 }
 
 
