     return 1;
 }
 /* blocks/wide/broad: why a range is (not) eligible; the census counts by this. */
+/* Porthole 0073 (experiment, off by default): MADEIRA_SWAP_FEX=1 lets the swap tier back FEX's own writable memory (its arena) as well. A heavy game
+ * (Sons of the Forest, 2026-10-06) died at the 6.1 GB limit with 1.9-2.3 GB of that in the arena, nearly all of it cold and sitting compressed in RAM, which
+ * iOS charges to the footprint; file-backed pages go to flash instead. Only wide coverage reaches the arena (broad skips the band above 0x7c00000000
+ * on purpose). The JIT pool stays excluded either way. */
+static int ios_swap_fex_arena_ok( void )
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "MADEIRA_SWAP_FEX" );
+        on = e && e[0] == '1' && ios_swap_wide;
+        if (e && e[0] == '1')
+            dprintf( 2, "[swap] 0073 FEX arena %s the file-backed tier (MADEIRA_SWAP_FEX=1, coverage=%s)\n",
+                     on ? "joins" : "stays out of (needs coverage wide)", ios_swap_mode );
+    }
+    return on;
+}
 static int ios_swap_is_fexjit( uintptr_t b, size_t size )
 {
     uintptr_t e = b + size, rx = (uintptr_t)ios_jit_rx_base_global, rw = (uintptr_t)ios_jit_rw_base_global;
     size_t ps = ios_jit_pool_size_global;
-    if (ios_fex_arena_base_unix && b < ios_fex_arena_end_unix && e > ios_fex_arena_base_unix) return 1;
+    if (ios_fex_arena_base_unix && b < ios_fex_arena_end_unix && e > ios_fex_arena_base_unix && !ios_swap_fex_arena_ok()) return 1;
     if (ps && rx && b < rx + ps && e > rx) return 1;
     if (ps && rw && b < rw + ps && e > rw) return 1;
     return 0;
