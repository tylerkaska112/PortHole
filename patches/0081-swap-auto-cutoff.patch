+/* Porthole 0081 (opt-in): the swap cut-off that drops when the app's memory gets tight.
+ *
+ * Sons of the Forest (2026-10-07): with the cut-off at 8 MB the loading runs twice as fast as with Wide, because Unity's hot 4 MB heap blocks stay in RAM,
+ * but they cost ~2.3 GB and the app reaches iOS's 6.1 GB limit near the end of the load (4 MB: the blocks go to the file, 2.9 GB, but the load is as slow
+ * as Wide; 6 MB behaves like 8 MB). So: MADEIRA_SWAP_AUTO_AT_MB = N keeps the cut-off at its normal value (swap-min-mb, 8 MB by default) until the footprint
+ * (ios_last_footprint_mb, published every 250 ms by the pool warmer) reaches N, then lowers it to MADEIRA_SWAP_AUTO_MIN_KB (default 1024 = 1 MB) for every
+ * commit from then on. What was allocated before stays where it is. One way: the floor never goes back up. Without the variable nothing changes. */
+static size_t ios_swap_floor( void )
+{
+    static int armed = -1, tripped;
+    static unsigned long long at_mb;
+    static size_t low;
+    if (armed < 0)
+    {
+        const char *e = getenv( "MADEIRA_SWAP_AUTO_AT_MB" ), *k = getenv( "MADEIRA_SWAP_AUTO_MIN_KB" );
+        unsigned long long kb = (k && strtoull( k, NULL, 10 ) >= 64) ? strtoull( k, NULL, 10 ) : 1024;
+        at_mb = e ? strtoull( e, NULL, 10 ) : 0;
+        armed = at_mb >= 512;
+        low = (size_t)kb << 10;
+        if (armed) dprintf( 2, "[swap] 0081 auto cut-off: %zu KB until the app footprint reaches %llu MB, then %zu KB (MADEIRA_SWAP_AUTO_AT_MB / MADEIRA_SWAP_AUTO_MIN_KB)\n",
+                            ios_swap_min >> 10, at_mb, low >> 10 );
+    }
+    if (!armed) return ios_swap_min;
+    if (!tripped && ios_last_footprint_mb >= at_mb)
+    {
+        tripped = 1;
+        dprintf( 2, "[swap] 0081 auto cut-off: app footprint %llu MB >= %llu MB, commits of %zu KB and more go to the file from now on\n", ios_last_footprint_mb, at_mb, low >> 10 );
+    }
+    return tripped && low < ios_swap_min ? low : ios_swap_min;
+}
