+/* 0136: frame generation can be switched on and off while the game runs (the in-game menu). The layer has to hand out drawables that can be read, so the layer's
+ * framebufferOnly flag follows the switch (kept from setProps); a frame whose drawable still comes from before the change is presented as it is. */
+static CAMetalLayer *g_fg_layer;
+static int g_fg_orig_fbo = 1;
+void madeira_framegen_set(int on, double hz) {
+  g_fg_on = on ? 1 : 0;
+  if (hz > 0) g_fg.hz = hz;
+  g_fg.have_prev = 0; g_fg.last_abs = 0; g_fg.dt = 0; g_fg.stat_abs = 0;
+  dprintf(STDERR_FILENO, "[framegen] %s from the app (screen %.0f Hz)\n", on ? "ON" : "OFF", hz > 0 ? hz : 0.0);
+  if (g_fg_layer) {
+    CAMetalLayer *l = g_fg_layer;
+    int fbo = on ? 0 : g_fg_orig_fbo;
+    dispatch_async(dispatch_get_main_queue(), ^{ l.framebufferOnly = fbo ? YES : NO; });
+  }
 }
+int madeira_framegen_get(void) { return madeira_fg_enabled() && !g_fg.dead; }
 
