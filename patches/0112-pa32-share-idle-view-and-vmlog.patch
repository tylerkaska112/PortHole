+/* 0112: the exported entry points record the call's outcome in ios_vmlog. */
+NTSTATUS WINAPI NtAllocateVirtualMemory( HANDLE process, PVOID *ret, ULONG_PTR zero_bits, SIZE_T *size_ptr, ULONG type, ULONG protect )
+{
+    uint64_t req_addr = ret ? (uint64_t)(uintptr_t)*ret : 0, req_size = size_ptr ? *size_ptr : 0;
+    NTSTATUS st = ios_vm_alloc_impl( process, ret, zero_bits, size_ptr, type, protect );
+    ios_vmlog_add( 'A', st ? req_addr : (ret ? (uint64_t)(uintptr_t)*ret : req_addr), st ? req_size : (size_ptr ? *size_ptr : req_size), type, protect, st );
+    return st;
+}
+
+NTSTATUS WINAPI NtFreeVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T *size_ptr, ULONG type )
+{
+    uint64_t a = addr_ptr ? (uint64_t)(uintptr_t)*addr_ptr : 0, sz = size_ptr ? *size_ptr : 0;
+    NTSTATUS st = ios_vm_free_impl( process, addr_ptr, size_ptr, type );
+    ios_vmlog_add( 'F', a, sz, type, 0, st );
+    return st;
+}
+
+NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T *size_ptr, ULONG new_prot, ULONG *old_prot )
+{
+    uint64_t a = addr_ptr ? (uint64_t)(uintptr_t)*addr_ptr : 0, sz = size_ptr ? *size_ptr : 0;
+    NTSTATUS st = ios_vm_protect_impl( process, addr_ptr, size_ptr, new_prot, old_prot );
+    ios_vmlog_add( 'P', a, sz, 0, new_prot, st );
+    return st;
+}
