+/* 0112: a ring of the last virtual-memory calls on addresses at or above 0x7000000000 (and every failure), dumped when a guest int3 is reported, so the next
+ * log says which commit or release the guest saw fail before it crashed. */
+#define IOS_VMLOG_N 96
+static struct { uint64_t addr, size; unsigned tid, type, prot, st; char op; } ios_vmlog[IOS_VMLOG_N];
+static unsigned ios_vmlog_seq;
+static void ios_vmlog_add( char op, uint64_t addr, uint64_t size, ULONG type, ULONG prot, NTSTATUS st )
+{
+    unsigned i;
+    if (addr < 0x7000000000ULL && !st) return;
+    i = __atomic_fetch_add( &ios_vmlog_seq, 1, __ATOMIC_RELAXED ) % IOS_VMLOG_N;
+    ios_vmlog[i].op = op; ios_vmlog[i].addr = addr; ios_vmlog[i].size = size; ios_vmlog[i].type = type; ios_vmlog[i].prot = prot; ios_vmlog[i].st = st;
+    ios_vmlog[i].tid = NtCurrentTeb() ? (unsigned)(ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread : 0;
+}
+void ios_vmlog_dump( const char *why )
+{
+    unsigned n = ios_vmlog_seq, i, from = n > IOS_VMLOG_N ? n - IOS_VMLOG_N : 0;
+    dprintf( 2, "[vmlog] 0112 last %u virtual-memory calls (%s), oldest first\n", n - from, why );
+    for (i = from; i < n; i++)
+    {
+        unsigned k = i % IOS_VMLOG_N;
+        dprintf( 2, "[vmlog] %c tid=%04x addr=0x%llx size=0x%llx type=0x%x prot=0x%x st=0x%x\n", ios_vmlog[k].op, ios_vmlog[k].tid,
+                 (unsigned long long)ios_vmlog[k].addr, (unsigned long long)ios_vmlog[k].size, ios_vmlog[k].type, ios_vmlog[k].prot, ios_vmlog[k].st );
+    }
+}
