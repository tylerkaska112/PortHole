+/* Porthole 0068 (diagnostic): write the decrypted code of the program that is spinning to Documents/bo3-dump/ so it can be analysed offline.
+ * Black Ops 3's executable is encrypted on disk and decrypts itself at start, so only a dump of the running process shows the protection's code.
+ * Files: meta.txt (registers, TEB/PEB, image base, sections), sec-<rva>-<name>.bin for the sections (the big uninitialised .data only in part),
+ * stack.bin (RSP - 0x1000 up to the stack base), peb.bin, teb.bin. Once per run, roughly 100 MB; delete the folder afterwards. */
+static void ios_dump_chunked( const char *dir, const char *name, uint64_t addr, uint64_t len )
+{
+    char path[1024];
+    FILE *f;
+    static unsigned char buf[0x100000];
+    uint64_t off;
+
+    snprintf( path, sizeof(path), "%s/%s", dir, name );
+    if (!(f = fopen( path, "wb" ))) return;
+    for (off = 0; off < len; off += sizeof(buf))
+    {
+        size_t n = len - off < sizeof(buf) ? (size_t)(len - off) : sizeof(buf);
+        if (!ios_ts_read( addr + off, buf, n )) memset( buf, 0, n );   /* unreadable pages are written as zeros */
+        fwrite( buf, 1, n, f );
+    }
+    fclose( f );
+}
+
+static void ios_dump_process_for_analysis( uint64_t rip, uint64_t rsp, uint64_t teb, const uint64_t *g )
+{
+    const char *docs = getenv( "MADEIRA_DOCS_DIR" );
+    char dir[900], path[1024];
+    uint64_t base = 0, a;
+    FILE *meta;
+    unsigned i;
+
+    if (!docs) return;
+    snprintf( dir, sizeof(dir), "%s/bo3-dump2", docs );
+    mkdir( dir, 0777 );
+    for (a = rip & ~0xffffull; a > (rip > 0x20000000ull ? rip - 0x20000000ull : 0x10000); a -= 0x10000)
+    {
+        unsigned short mz = 0;
+        if (ios_ts_read( a, &mz, 2 ) && mz == 0x5a4d) { base = a; break; }
+    }
+    snprintf( path, sizeof(path), "%s/meta.txt", dir );
+    if (!(meta = fopen( path, "w" ))) return;
+    fprintf( meta, "rip=%#llx rsp=%#llx teb=%#llx image_base=%#llx\n", (unsigned long long)rip, (unsigned long long)rsp, (unsigned long long)teb, (unsigned long long)base );
+    if (g)
+        for (i = 0; i < 16; i++) fprintf( meta, "g%u=%#llx\n", i, (unsigned long long)g[i] );   /* RAX RCX RDX RBX RSP RBP RSI RDI R8..R15 */
+    if (base)
+    {
+        unsigned char hdr[0x1000];
+        if (ios_ts_read( base, hdr, sizeof(hdr) ))
+        {
+            unsigned lfanew = *(unsigned *)(hdr + 0x3c);
+            if (lfanew < 0x300)
+            {
+                unsigned nsec = *(unsigned short *)(hdr + lfanew + 6), optsz = *(unsigned short *)(hdr + lfanew + 20);
+                unsigned char *sec = hdr + lfanew + 24 + optsz;
+                fprintf( meta, "size_of_image=%#x sections=%u\n", *(unsigned *)(hdr + lfanew + 24 + 56), nsec );
+                for (i = 0; i < nsec && sec + 40 * (i + 1) <= hdr + sizeof(hdr); i++)
+                {
+                    unsigned char *e = sec + 40 * i;
+                    char nm[9] = { 0 };
+                    unsigned vsz, va, ch;
+                    uint64_t take;
+                    char fn[64];
+                    memcpy( nm, e, 8 );
+                    vsz = *(unsigned *)(e + 8); va = *(unsigned *)(e + 12); ch = *(unsigned *)(e + 36);
+                    take = vsz > 0x4000000u ? 0x400000u : vsz;      /* the huge .data: its first 4 MB only */
+                    fprintf( meta, "section %s va=%#x vsize=%#x chars=%#x dumped=%#llx\n", nm, va, vsz, ch, (unsigned long long)take );
+                    snprintf( fn, sizeof(fn), "sec-%08x-%s.bin", va, nm[0] == '.' ? nm + 1 : nm );
+                    ios_dump_chunked( dir, fn, base + va, take );
+                }
+            }
+        }
+        ios_dump_chunked( dir, "headers.bin", base, 0x1000 );
+    }
+    {
+        uint64_t sbase = 0;
+        if (teb && ios_ts_read( teb + 8, &sbase, 8 ) && sbase > rsp && sbase - rsp < 0x1000000)
+            ios_dump_chunked( dir, "stack.bin", (rsp - 0x1000) & ~0xfffull, ((sbase - rsp) + 0x1000 + 0xfff) & ~0xfffull );
+        fprintf( meta, "stack_dump_start=%#llx stack_base=%#llx\n", (unsigned long long)((rsp - 0x1000) & ~0xfffull), (unsigned long long)sbase );
+        if (teb) ios_dump_chunked( dir, "teb.bin", teb, 0x2000 );
+        {
+            uint64_t peb = 0;
+            if (teb && ios_ts_read( teb + 0x60, &peb, 8 ) && peb)
+            {
+                fprintf( meta, "peb=%#llx\n", (unsigned long long)peb );
+                ios_dump_chunked( dir, "peb.bin", peb, 0x1000 );
+            }
+        }
+    }
+    fclose( meta );
+    wine_log_write( "[dump] 0068 wrote the running program's memory to %s", dir );
 }
 
