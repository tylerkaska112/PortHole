+
+/* Porthole 0034: two slots of the spill band were refused for reasons that do not hold.
+ *
+ * (1) Slot 0x74: the PREVIOUS slot (0x73) owns its guard page, which sits in the first 16 KB of the next slot's range, so
+ *     "the 4GB range is not free (OCCUPIED 0x73ffff0000+0x14000 prot=0/7)". That page is PROT_NONE and lies in guest page 0,
+ *     which no guest ever uses (IOS_WOW_GUEST_FLOOR): it is as good as the window's own first page. ios_wow_leading_none()
+ *     reports how many bytes at the start of `base` are already such a region, and the window is mapped from there.
+ * (2) Slot 0x7a: the window fits but the guard page would lie past IOS_WOW_SPILL_TOP and the next page is an unmapped hole.
+ *     A hole faults on access like a guard does, so an unguarded window is accepted there (spill walk only).
+ *
+ * Ubisoft Connect's Chromium (browser, gpu, network, storage, 2-3 renderers) plus the launcher and UplayService needs 9 32-bit
+ * processes; without this there were 7 slots and the page renderer or the service had none (`guest window reserve returned
+ * 0xc0000017`, a blank white client window / "Preparing to launch your game" for ever). MADEIRA_WOW_EXTRA_SLOTS=0 turns it off. */
+static int ios_wow_extra_slots(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv( "MADEIRA_WOW_EXTRA_SLOTS" );
+        cached = !(e && *e == '0');
+    }
+    return cached;
+}
+
+static ULONG_PTR ios_wow_leading_none( ULONG_PTR base )
+{
+    mach_vm_address_t a = (mach_vm_address_t)base;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t obj = MACH_PORT_NULL;
+    mach_vm_address_t end;
+
+    if (!ios_wow_extra_slots()) return 0;
+    if (mach_vm_region( mach_task_self(), &a, &size, VM_REGION_BASIC_INFO_64,
+                        (vm_region_info_t)&info, &cnt, &obj ) != KERN_SUCCESS) return 0;
+    if (a >= (mach_vm_address_t)base) return 0;            /* nothing straddles the start */
+    if (info.protection != VM_PROT_NONE) return 0;
+    end = a + size;
+    if (end <= (mach_vm_address_t)base || end > (mach_vm_address_t)base + 0x20000) return 0;   /* only a guard-sized overlap */
+    return (ULONG_PTR)(end - (mach_vm_address_t)base);
+}
+
+static int ios_wow_neighbour_is_hole( ULONG_PTR addr, ULONG_PTR len )
+{
+    mach_vm_address_t a = (mach_vm_address_t)addr;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t obj = MACH_PORT_NULL;
+
+    if (!ios_wow_extra_slots()) return 0;
+    if (mach_vm_region( mach_task_self(), &a, &size, VM_REGION_BASIC_INFO_64,
+                        (vm_region_info_t)&info, &cnt, &obj ) != KERN_SUCCESS) return 1;   /* nothing mapped from here up */
+    return a >= (mach_vm_address_t)(addr + len);
 }
 
