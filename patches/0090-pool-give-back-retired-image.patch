-        ios_jit_mappings[i].size = 0;
-        __sync_synchronize();
-        ios_jit_mappings[i].pe_base = NULL;
-        retired++;
+        {
+            char *jb = (char *)ios_jit_mappings[i].jit_base;
+            void *mapper = ios_jit_mappings[i].map_peb;
+            ios_jit_mappings[i].size = 0;
