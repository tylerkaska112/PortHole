 #include "llvm/IR/Constants.h"
 #include "llvm/IR/DerivedTypes.h"
 #include "llvm/IR/IRBuilder.h"
 
+// f4-0004: MADEIRA_PRECISE_MATH=1 makes the DXBC converter use the exact AIR math functions (air.log2, air.exp2, air.pow, ...) instead of the "fast_" ones,
+// and sets no fast-math flags. Read once, at the first shader compile.
+inline bool airconv_precise_math() {
+  static const bool precise = [] { const char *e = std::getenv("MADEIRA_PRECISE_MATH"); return e && *e == '1'; }();
+  return precise;
+}
