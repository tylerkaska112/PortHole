+                NSString *ecDir = [bundlePath stringByAppendingPathComponent:@"arm64ec-windows"];
+                NSString *aaDir = [bundlePath stringByAppendingPathComponent:@"aarch64-windows"];
+                int extraLinked = 0;
+                for (NSString *dll in [fm contentsOfDirectoryAtPath:vcrtDir error:nil]) {
+                    if (![dll.pathExtension.lowercaseString isEqualToString:@"dll"]) continue;
+                    if ([fm fileExistsAtPath:[ecDir stringByAppendingPathComponent:dll]] ||
+                        [fm fileExistsAtPath:[aaDir stringByAppendingPathComponent:dll]]) continue;
+                    NSString *src = [vcrtDir stringByAppendingPathComponent:dll];
+                    BOOL ok = NO;
+                    for (NSString *sub in @[ @"sysx64", @"system32" ]) {
+                        NSString *dst = [[prefix stringByAppendingPathComponent:
+                            [NSString stringWithFormat:@"drive_c/windows/%@", sub]] stringByAppendingPathComponent:dll];
+                        [fm removeItemAtPath:dst error:nil];
+                        if ([fm createSymbolicLinkAtPath:dst withDestinationPath:src error:nil]) ok = YES;
+                    }
+                    if (ok) extraLinked++;
+                }
+                dprintf(STDERR_FILENO, "[WineProc] x64 VC++ DLLs missing from the ARM64EC bundle: %d linked into sysx64 + system32 (from %s)\n",
+                        extraLinked, vcrtDir == vcrtDown ? "downloaded runtime" : "app bundle");
+            }
