+            /* Porthole: the x64 VC++ runtime DLLs the ARM64EC bundle has no copy of (vcomp140, vcamp140, vccorlib140, vcruntime140_threads).
+             * The overlay further down only runs when the session's own target is x64, but the Dock session is an aarch64 explorer that
+             * starts the game as a child, so an x64 game importing vcomp140 (Far Cry 6's FC_m64d3d12.dll) died with c0000135. DLLs the bundle
+             * does have are left alone: they keep their ARM64EC builtins, as the exemptions in the overlay below require. */
+            {
+                NSString *vcrtDir = [bundlePath stringByAppendingPathComponent:@"x86_64-vcruntime"];
