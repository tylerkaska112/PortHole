+/* 0152: env.MADEIRA_GLUED_MAIN = 1 (the app sets it, with MADEIRA_SC_PA_POOLS = 1, for BeamNG.drive; see GameFixes). Read once. */
+static int ios_glued_main( void )
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv( "MADEIRA_GLUED_MAIN" );
+        cached = (e && *e == '1') ? 1 : 0;
+        if (cached) dprintf( 2, "[sc-cef] 0152 the game's own process gets a PartitionAlloc pool in two real parts (MADEIRA_GLUED_MAIN=1)\n" );
+    }
+    return cached;
+}
