+/* 0152: a PartitionAlloc pool block (32 GB asked on a 32 GB boundary) for the game's OWN process, served in two real parts (opt-in, MADEIRA_GLUED_MAIN=1 with
+ * MADEIRA_SC_PA_POOLS=1, whose boot holds [0x7c00000000, +4 GB) below the emulator's arena). ios_sc_glued_pools gives Social Club's helper one 20 GB view
+ * [0x7800000000, 0x7d00000000); here that range is cut by the image window ([0x7a00000000, +4 GB), where the DLLs of the 64-bit farm are mapped: BeamNG.drive's log of
+ * 2026-10-16 shows `is not free (st=0xc0000018)` and images at 0x7a7bba0000), so the two parts that PartitionAlloc really fills are reserved on their own:
+ * the bottom of the regular pool, [0x7800000000, +8 GB), and the bottom of the BackupRefPtr pool, [0x7c00000000, +4 GB). PartitionAlloc takes super pages first-fit
+ * from the bottom of each pool, so a UI's few hundred MB stay inside them; the 32 GB are reported whole. A commit past either part fails as on any unreserved
+ * address. Returns 0 with the grant in *pick / *sz, else a failure status with nothing reserved. */
+#define IOS_GLUED_MAIN_LOW 0x200000000ULL   /* 8 GB of the regular pool */
+static NTSTATUS ios_glued_main_grant( void **pick, SIZE_T *sz, ULONG type, ULONG protect )
+{
+    void *lo = (void *)(uintptr_t)IOS_SC_GLUED_BASE, *hi = (void *)(uintptr_t)IOS_SC_BRP_HOLD_BASE;
+    SIZE_T lsz = IOS_GLUED_MAIN_LOW, hsz = IOS_SC_BRP_HOLD_SIZE;
+    NTSTATUS st;
+    static int taken;
 
+    if (!ios_sc_brp_layout || !ios_sc_brp_held || taken)
+    {
+        static int said;
+        if (!said++)
+            dprintf( 2, "[sc-cef] 0152 no glued pool for the game's own process: %s\n",
+                     taken ? "already given once" : "the emulator's arena was not moved at boot (needs MADEIRA_SC_PA_POOLS=1)" );
+        return STATUS_NO_MEMORY;
+    }
+    st = allocate_virtual_memory( &lo, &lsz, type, protect, 0, 0, 0, 0 );
+    if (st || (uintptr_t)lo != IOS_SC_GLUED_BASE)
+    {
+        if (!st) { SIZE_T fsz = 0; void *fb = lo; NtFreeVirtualMemory( NtCurrentProcess(), &fb, &fsz, MEM_RELEASE ); }
+        dprintf( 2, "[sc-cef] 0152 [0x%llx,+%llu GB) is not free (st=0x%x): no glued pool\n", IOS_SC_GLUED_BASE, (unsigned long long)(IOS_GLUED_MAIN_LOW >> 30), (unsigned)st );
+        return st ? st : STATUS_NO_MEMORY;
+    }
+    mach_vm_deallocate( mach_task_self(), IOS_SC_BRP_HOLD_BASE, IOS_SC_BRP_HOLD_SIZE );
+    ios_sc_brp_held = 0;
+    st = allocate_virtual_memory( &hi, &hsz, type, protect, 0, 0, 0, 0 );
+    if (st || (uintptr_t)hi != IOS_SC_BRP_HOLD_BASE)
+    {
+        mach_vm_address_t h = IOS_SC_BRP_HOLD_BASE;
+        SIZE_T fsz = 0; void *fb = lo;
+        if (!st) { SIZE_T gsz = 0; void *gb = hi; NtFreeVirtualMemory( NtCurrentProcess(), &gb, &gsz, MEM_RELEASE ); }
+        NtFreeVirtualMemory( NtCurrentProcess(), &fb, &fsz, MEM_RELEASE );
+        if (mach_vm_map( mach_task_self(), &h, IOS_SC_BRP_HOLD_SIZE, 0, VM_FLAGS_FIXED, MEMORY_OBJECT_NULL, 0, 0,
+                         PROT_NONE, VM_PROT_ALL, VM_INHERIT_COPY ) == KERN_SUCCESS)
+            ios_sc_brp_held = 1;
+        dprintf( 2, "[sc-cef] 0152 [0x%llx,+%llu GB) is not free (st=0x%x): no glued pool\n", IOS_SC_BRP_HOLD_BASE, (unsigned long long)(IOS_SC_BRP_HOLD_SIZE >> 30), (unsigned)st );
+        return st ? st : STATUS_NO_MEMORY;
+    }
+    taken = 1;
+    *pick = lo;
+    *sz = IOS_SC_GLUED_SIZE;
+    dprintf( 2, "[sc-cef] 0152 glued PartitionAlloc pool for the game's own process: 32 GB reported at 0x%llx, really [0x%llx,+%llu GB) and [0x%llx,+%llu GB)\n",
+             IOS_SC_GLUED_BASE, IOS_SC_GLUED_BASE, (unsigned long long)(IOS_GLUED_MAIN_LOW >> 30), IOS_SC_BRP_HOLD_BASE, (unsigned long long)(IOS_SC_BRP_HOLD_SIZE >> 30) );
+    return STATUS_SUCCESS;
+}
