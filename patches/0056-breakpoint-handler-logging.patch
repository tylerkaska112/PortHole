+
+
+/* Porthole 0057 (diagnostic): the code of a guest exception handler. Black Ops 3's breakpoint handlers answer ExceptionContinueSearch (1) where
+ * Windows' must claim the exception; their code is obfuscated blocks joined by `jmp rel32`, so walk the jumps breadth first (96 bytes per block,
+ * up to 120 blocks, once per handler) and log the hex; also the handler's data (the scope table) and the dispatcher context. */
+static BOOL ios_read_guest( ULONG_PTR addr, void *buf, SIZE_T len )
+{
+    SIZE_T got = 0;
+    return !NtReadVirtualMemory( NtCurrentProcess(), (void *)addr, buf, len, &got ) && got == len;
+}
+
+static void ios_dump_code_graph( const char *label, ULONG_PTR start, unsigned max_blocks )
+{
+    ULONG_PTR queue[160];
+    unsigned qn = 0, qi = 0, i;
+
+    queue[qn++] = start;
+    while (qi < qn && qi < max_blocks)
+    {
+        unsigned char blk[96]; char row[sizeof(blk) * 2 + 1];
+        ULONG_PTR a = queue[qi++];
+        if (!ios_read_guest( a, blk, sizeof(blk) )) continue;
+        for (i = 0; i < sizeof(blk); i++) sprintf( row + i * 2, "%02x", blk[i] );
+        ERR( "[handler-dump] 0057 %s block %p: %s\n", label, (void *)a, row );
+        for (i = 0; i + 5 <= sizeof(blk); i++)
+        {
+            int off, len;
+            if (blk[i] == 0xe9) { off = 1; len = 5; }
+            else if (blk[i] == 0x0f && i + 6 <= sizeof(blk) && blk[i + 1] >= 0x80 && blk[i + 1] <= 0x8f) { off = 2; len = 6; }
+            else continue;
+            {
+                LONG rel; ULONG_PTR t; unsigned z;
+                memcpy( &rel, blk + i + off, 4 );
+                t = a + i + len + (LONG_PTR)rel;
+                if (t < start - 0x40000000 || t > start + 0x40000000) continue;
+                for (z = 0; z < qn; z++) if (queue[z] == t) break;
+                if (z == qn && qn < ARRAY_SIZE(queue)) queue[qn++] = t;
+            }
+        }
+    }
 }
 
+static void ios_dump_handler_blocks( ULONG_PTR handler, const DISPATCHER_CONTEXT_ARM64EC *dispatch )
+{
+    static ULONG_PTR done_h[8], done_d[16];
+    static LONG nh, nd;
+    unsigned i;
+    LONG idx;
+
+    for (i = 0; i < ARRAY_SIZE(done_h); i++) if (done_h[i] == handler) break;
+    if (i == ARRAY_SIZE(done_h) && (idx = InterlockedIncrement( &nh ) - 1) < (LONG)ARRAY_SIZE(done_h))
+    {
+        done_h[idx] = handler;
+        ERR( "[handler-dump] 0057 handler=%p image=%p control_pc=%p frame=%p func_entry=%p handler_data=%p\n", (void *)handler, (void *)dispatch->ImageBase,
+             (void *)dispatch->ControlPc, (void *)dispatch->EstablisherFrame, dispatch->FunctionEntry, dispatch->HandlerData );
+        ios_dump_code_graph( "handler", handler, 120 );
+    }
+    /* The scope table (C-specific handler data: count, then {Begin, End, Handler, Target} RVAs): dump the code of the filter of the scope that
+     * covers the control pc, once per handler data. */
+    if (dispatch->HandlerData)
+    {
+        ULONG_PTR hd = (ULONG_PTR)dispatch->HandlerData;
+        for (i = 0; i < ARRAY_SIZE(done_d); i++) if (done_d[i] == hd) return;
+        if ((idx = InterlockedIncrement( &nd ) - 1) >= (LONG)ARRAY_SIZE(done_d)) return;
+        done_d[idx] = hd;
+        {
+            ULONG scope[1 + 4 * 24];
+            ULONG count, k, rva = (ULONG)(dispatch->ControlPc - dispatch->ImageBase);
+            if (!ios_read_guest( hd, scope, 4 * sizeof(ULONG) + sizeof(ULONG) )) return;
+            count = scope[0];
+            if (!count || count > 24 || !ios_read_guest( hd, scope, (1 + count * 4) * sizeof(ULONG) )) return;
+            for (k = 0; k < count; k++)
+            {
+                ULONG begin = scope[1 + k * 4], end = scope[2 + k * 4], filter = scope[3 + k * 4], target = scope[4 + k * 4];
+                ERR( "[handler-dump] 0057 scope data %p #%lu begin=%lx end=%lx filter=%lx target=%lx control_rva=%lx\n", (void *)hd, k, begin, end, filter, target, rva );
+                if (rva >= begin && rva < end && filter > 1)
+                {
+                    char label[48];
+                    sprintf( label, "filter#%lu", k );
+                    ios_dump_code_graph( label, dispatch->ImageBase + filter, 100 );
+                }
+            }
+        }
+    }
+}
 
