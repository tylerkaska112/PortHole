+#ifdef FEX_IOS_HOST
+/* 0.50.345: who misses in the L1 lookup cache. A profile of The Forest showed 7 % of the main thread in LookupCache::CacheBlockMapping and its hash maps and 75-95K L1 misses
+ * a second. Counts misses where the slot held another block (a conflict: the cache is direct-mapped on the low 17 bits of the guest address) against an empty slot (cold or
+ * invalidated), and keeps the heaviest missing addresses (every 16th miss, Misra-Gries in 4096 hashed slots); written with the [l1-miss] line. */
+struct IosL1MissNotes {
+  std::atomic<uint64_t> Empty {0}, Conflict {0}, Seq {0};
+  struct Slot { std::atomic<uint64_t> Key {0}; std::atomic<uint32_t> Count {0}; };
+  Slot Tab[4096];
+  void Note(uint64_t Address, uint64_t Resident) {
+    (Resident ? Conflict : Empty).fetch_add(1, std::memory_order_relaxed);
+    if (Seq.fetch_add(1, std::memory_order_relaxed) & 15) return;
+    Slot& E = Tab[(Address * 0x9E3779B97F4A7C15ULL) >> 52];
+    if (E.Key.load(std::memory_order_relaxed) == Address) E.Count.fetch_add(1, std::memory_order_relaxed);
+    else if (E.Count.load(std::memory_order_relaxed) == 0) { E.Key.store(Address, std::memory_order_relaxed); E.Count.store(1, std::memory_order_relaxed); }
+    else E.Count.fetch_sub(1, std::memory_order_relaxed);
+  }
+  void Dump() {
+    uint64_t Key[8] = {}; uint32_t Cnt[8] = {};
+    for (auto& S : Tab) {
+      const uint32_t C = S.Count.load(std::memory_order_relaxed);
+      if (!C) continue;
+      for (int i = 0; i < 8; i++) if (C > Cnt[i]) { for (int j = 7; j > i; j--) { Key[j] = Key[j - 1]; Cnt[j] = Cnt[j - 1]; } Key[i] = S.Key.load(std::memory_order_relaxed); Cnt[i] = C; break; }
+    }
+    LogMan::Msg::EFmt("[l1-miss] slot was empty: {}, held another block: {}; heaviest missing addresses (x16): {:#x}:{} {:#x}:{} {:#x}:{} {:#x}:{} {:#x}:{} {:#x}:{} {:#x}:{} {:#x}:{}",
+                      Empty.load(), Conflict.load(), Key[0], Cnt[0], Key[1], Cnt[1], Key[2], Cnt[2], Key[3], Cnt[3], Key[4], Cnt[4], Key[5], Cnt[5], Key[6], Cnt[6], Key[7], Cnt[7]);
+  }
+};
+inline IosL1MissNotes& IosL1Notes() { static IosL1MissNotes N; return N; }
+#endif
