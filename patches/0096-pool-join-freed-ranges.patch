+            b2 = a2 - 1;
+            while (b2 >= 0 && ios_pool_freelist[b2].off > key.off) { ios_pool_freelist[b2 + 1] = ios_pool_freelist[b2]; b2--; }
+            ios_pool_freelist[b2 + 1] = key;
+        }
+        for (a2 = 0; a2 + 1 < ios_pool_free_count; )
+        {
+            struct ios_pool_free *x = &ios_pool_freelist[a2], *y = &ios_pool_freelist[a2 + 1];
