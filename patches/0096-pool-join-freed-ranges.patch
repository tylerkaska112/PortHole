+            {
+                x->size += y->size;
+                if (y->freed_at > x->freed_at) x->freed_at = y->freed_at;
+                x->advised = x->advised && y->advised;
+                x->split = x->split && y->split;
+                for (b2 = a2 + 1; b2 + 1 < ios_pool_free_count; b2++) ios_pool_freelist[b2] = ios_pool_freelist[b2 + 1];
+                ios_pool_free_count--;
+                merged++;
+            }
+            else a2++;
+        }
+        if (merged)
+            dprintf(2, "[jit-pool] 0096 joined %d touching freed range(s); freelist now %d\n", merged, ios_pool_free_count);
     }
 
