+
+/* Porthole 0131: name the locale that failed. Sekiro's startup throws std::runtime_error("bad locale name") (the STL does that when setlocale/_create_locale returns NULL), and
+ * nothing said which name or why. */
+static pthreadlocinfo create_locinfo_logged(int category, const char *locale, const threadlocinfo *old_locinfo)
+{
+    pthreadlocinfo r = create_locinfo(category, locale, old_locinfo);
+    static LONG n;
+    if (!r && InterlockedIncrement(&n) <= 24)
+        ERR("[locale] 0131 category %d name \"%s\" failed (ACP %u, OEMCP %u, user locale %04x)\n", category, locale ? locale : "(null)",
+            (unsigned)GetACP(), (unsigned)GetOEMCP(), (unsigned)GetUserDefaultLCID());
+    return r;
 }
 
