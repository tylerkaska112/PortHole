+
+/* Porthole 0084: an x64 program's own folder can hold a copy of the Universal C Runtime (Rockstar's launcher folder has one). The ARM64EC emulator DLL imports the C
+ * runtime through its API-set names, which resolve to ucrtbase.dll, and the loader looks in the program's folder before System32: the emulator then got the program's x64
+ * copy, called its entry point natively (the emulator does not exist yet) and the process died with an illegal instruction. One ucrtbase.dll serves a whole process, so a
+ * copy outside the system folders is served from the ARM64EC build in sysx64 instead. MADEIRA_APP_LOCAL_UCRT=1 keeps the program's own copy. */
+static BOOL ios_app_ucrt_alt_name( const UNICODE_STRING *name, WCHAR *buf, UNICODE_STRING *alt )
+{
+    static const char leaf[] = "\\ucrtbase.dll";
+    static const char sysx64[] = "\\??\\C:\\windows\\sysx64\\ucrtbase.dll";
+    static const char *system_dirs[] = { "\\??\\C:\\windows\\system32\\", "\\??\\C:\\windows\\sysx64\\", "\\??\\C:\\windows\\syswow64\\", "\\??\\C:\\windows\\sysarm32\\" };
+    unsigned int i, j, len = name->Length / sizeof(WCHAR), llen = sizeof(leaf) - 1;
+
+    if (!name->Buffer || len <= llen + 4 || len > MAX_PATH) return FALSE;
+    for (i = 0; i < llen; i++)
+    {
+        WCHAR c = name->Buffer[len - llen + i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c == '/') c = '\\';
+        if (c != (WCHAR)leaf[i]) return FALSE;
+    }
+    for (j = 0; j < sizeof(system_dirs) / sizeof(system_dirs[0]); j++)
+    {
+        unsigned int dlen = strlen( system_dirs[j] );
+        if (len != dlen + llen - 1) continue;
+        for (i = 0; i < dlen; i++)
+        {
+            WCHAR c = name->Buffer[i], d = system_dirs[j][i];
+            if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+            if (d >= 'A' && d <= 'Z') d += 'a' - 'A';
+            if (c != d && !(c == '/' && d == '\\')) break;
+        }
+        if (i == dlen) return FALSE;     /* already a system copy */
+    }
+    if (getenv( "MADEIRA_APP_LOCAL_UCRT" )) return FALSE;
+    for (i = 0; i < sizeof(sysx64) - 1; i++) buf[i] = sysx64[i];
+    buf[i] = 0;
+    alt->Buffer = buf;
+    alt->Length = (sizeof(sysx64) - 1) * sizeof(WCHAR);
+    alt->MaximumLength = alt->Length + sizeof(WCHAR);
+    return TRUE;
+}
 #endif
 
