+/* Porthole patch 0019: the read counters above, summed over every XInput slot and the HID pad. */
+uint64_t winios_gamepad_read_count(void)
+{
+    uint64_t total = __atomic_load_n(&hid_reads, __ATOMIC_RELAXED);
+    for (int i = 0; i < WINIOS_GAMEPAD_MAX; i++) total += __atomic_load_n(&pad_reads[i], __ATOMIC_RELAXED);
+    return total;
+}
