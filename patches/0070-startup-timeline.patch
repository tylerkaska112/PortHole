+/* Porthole 0070 (diagnostic): a timeline of the busiest guest thread from the start of the run, to see how a long loop was entered. Every 50 ms
+ * the live registers (0069) of the thread with the most CPU are read; when its (rsp, rbp) pair changes, the stack from rsp-0x40 for 0x400 bytes
+ * is saved. Documents/bo3-timeline/: index.txt (ms, thread, cpu%, rip, rsp, rbp, rax, rcx, rdx, file) and s<n>.bin. At most 600 snapshots,
+ * for the first 150 s. Delete the folder afterwards. */
+static void *ios_timeline_main( void *arg )
+{
+    const char *docs = getenv( "MADEIRA_DOCS_DIR" );
+    char dir[900], path[1024];
+    FILE *idx;
+    struct timespec t0, now;
+    uint64_t last_rsp = 0, last_rbp = 0;
+    unsigned nsnap = 0;
+    (void)arg;
+    if (!docs) return NULL;
+    snprintf( dir, sizeof(dir), "%s/bo3-timeline", docs );
+    mkdir( dir, 0777 );
+    snprintf( path, sizeof(path), "%s/index.txt", dir );
+    if (!(idx = fopen( path, "w" ))) return NULL;
+    clock_gettime( CLOCK_MONOTONIC, &t0 );
+    for (;;)
+    {
+        mach_port_t self_port = pthread_mach_thread_np( pthread_self() ), best = 0;
+        thread_act_array_t tlist;
+        mach_msg_type_number_t tcount, k;
+        int best_cpu = 0;
+        long ms;
+        usleep( 50000 );
+        clock_gettime( CLOCK_MONOTONIC, &now );
+        ms = (now.tv_sec - t0.tv_sec) * 1000 + (now.tv_nsec - t0.tv_nsec) / 1000000;
+        if (ms > 150000 || nsnap >= 600) break;
+        if (task_threads( mach_task_self(), &tlist, &tcount ) != KERN_SUCCESS) continue;
+        for (k = 0; k < tcount; k++)
+        {
+            thread_basic_info_data_t bi;
+            mach_msg_type_number_t bic = THREAD_BASIC_INFO_COUNT;
+            if (tlist[k] == self_port) continue;
+            if (thread_info( tlist[k], THREAD_BASIC_INFO, (thread_info_t)&bi, &bic ) != KERN_SUCCESS) continue;
+            if (bi.cpu_usage > best_cpu) { best_cpu = bi.cpu_usage; best = tlist[k]; }
+        }
+        if (best && best_cpu >= 300)
+        {
+            uint64_t g[16], rip = 0;
+            uint32_t cpsr;
+            const char *why = "";
+            if (ios_live_snapshot( best, g, &rip, &cpsr, &why ) && g[4] > 0x10000 && (g[4] != last_rsp || g[5] != last_rbp))
+            {
+                unsigned char buf[0x400];
+                char fn[64] = "-";
+                last_rsp = g[4]; last_rbp = g[5];
+                if (ios_ts_read( g[4] - 0x40, buf, sizeof(buf) ))
+                {
+                    FILE *f;
+                    snprintf( fn, sizeof(fn), "s%u.bin", nsnap );
+                    snprintf( path, sizeof(path), "%s/%s", dir, fn );
+                    if ((f = fopen( path, "wb" ))) { fwrite( buf, 1, sizeof(buf), f ); fclose( f ); }
+                }
+                fprintf( idx, "%ld t%u cpu%d rip=%#llx rsp=%#llx rbp=%#llx rax=%#llx rcx=%#llx rdx=%#llx %s\n", ms, (unsigned)best, best_cpu / 10,
+                         (unsigned long long)rip, (unsigned long long)g[4], (unsigned long long)g[5], (unsigned long long)g[0],
+                         (unsigned long long)g[1], (unsigned long long)g[2], fn );
+                fflush( idx );
+                nsnap++;
+            }
+        }
+        for (k = 0; k < tcount; k++) mach_port_deallocate( mach_task_self(), tlist[k] );
+        vm_deallocate( mach_task_self(), (vm_address_t)tlist, tcount * sizeof(*tlist) );
+    }
+    fclose( idx );
+    return NULL;
+}
+
+
+/* 0070: set when a program called blackops3.exe is started (process_ios.c); the timeline and the 0068 dump are for that program only. */
+volatile int ios_blackops3_started;
+void ios_timeline_start( void )
+{
+    static int started;
+    pthread_t tl;
+    if (started) return;
+    started = 1;
+    if (!pthread_create( &tl, NULL, ios_timeline_main, NULL )) pthread_detach( tl );
+}
