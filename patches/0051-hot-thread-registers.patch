--- a/build/ntdll-unix/server_ios.c
+++ b/build/ntdll-unix/server_ios.c
@@ -792,6 +792,43 @@
             }
             wine_log_write("%s", line);
             printed++;
+            /* Porthole 0051 (diagnostic): the guest registers and the frame of a thread that is burning a core in guest code, to read what a
+             * long loop is walking (Black Ops 3's protection spins for minutes in one block). Host register -> x86 register mapping as in
+             * the fault dump (rax x8, rcx x0, rdx x1, rbx x27, rsp x23, rbp fp, rsi x25, rdi x26, r8-r11 x2-x5, r12-r15 x19-x22). */
+            if (rip && bi.cpu_usage >= 900)
+            {
+                static int regs_logged;
+                if (regs_logged < 24)
+                {
+                    uint64_t rb = st.__fp, ptr = 0, qs[8];
+                    unsigned char loc[0xa0], pm[0x80];
+                    int have_loc, have_ptr = 0, j, m;
+                    regs_logged++;
+                    wine_log_write( "[thread-regs] 0051 rip=%#llx RAX=%#llx RCX=%#llx RDX=%#llx RBX=%#llx RSP=%#llx RBP=%#llx RSI=%#llx RDI=%#llx "
+                                    "R8=%#llx R9=%#llx R10=%#llx R11=%#llx R12=%#llx R13=%#llx R14=%#llx R15=%#llx",
+                                    (unsigned long long)rip, (unsigned long long)st.__x[8], (unsigned long long)st.__x[0], (unsigned long long)st.__x[1],
+                                    (unsigned long long)st.__x[27], (unsigned long long)st.__x[23], (unsigned long long)rb, (unsigned long long)st.__x[25],
+                                    (unsigned long long)st.__x[26], (unsigned long long)st.__x[2], (unsigned long long)st.__x[3], (unsigned long long)st.__x[4],
+                                    (unsigned long long)st.__x[5], (unsigned long long)st.__x[19], (unsigned long long)st.__x[20], (unsigned long long)st.__x[21],
+                                    (unsigned long long)st.__x[22] );
+                    have_loc = ios_ts_read( rb + 0x30, loc, sizeof(loc) );
+                    if (have_loc)
+                    {
+                        char row[sizeof(loc) * 2 + 1];
+                        for (j = 0; j < (int)sizeof(loc); j++) snprintf( row + j * 2, 3, "%02x", loc[j] );
+                        wine_log_write( "[thread-regs] 0051 [rbp+0x30..0xd0]: %s", row );
+                        memcpy( &ptr, loc + 0x50, 8 );
+                        have_ptr = ptr > 0x10000 && ios_ts_read( ptr - 0x20, pm, sizeof(pm) );
+                    }
+                    if (have_ptr)
+                    {
+                        char row[sizeof(pm) * 2 + 1];
+                        for (m = 0; m < (int)sizeof(pm); m++) snprintf( row + m * 2, 3, "%02x", pm[m] );
+                        wine_log_write( "[thread-regs] 0051 *(rbp+0x80)=%#llx, from -0x20: %s", (unsigned long long)ptr, row );
+                    }
+                    (void)qs;
+                }
+            }
         }
     }
     for (k = 0; k < tcount; k++) mach_port_deallocate(mach_task_self(), tlist[k]);
