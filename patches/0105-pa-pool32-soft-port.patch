+    if (!st && (uintptr_t)pick == IOS_CAGE_BASE)
+    {
+        *ret = pick;
+        *size_ptr = req_size;   /* report the full 8GB; the real view is 64KB short, like the CEF grant */
+        if (ios_soft_n < IOS_SOFT_MAX)
+        {
+            ios_soft[ios_soft_n].base = IOS_CAGE_BASE + IOS_CAGE_REAL_SIZE;
+            ios_soft[ios_soft_n].size = 0x200000000ULL - IOS_CAGE_REAL_SIZE;
+            ios_soft[ios_soft_n].cage = 1;
+            ios_soft_n++;
+        }
+    }
+    else if (!st) { *ret = pick; *size_ptr = csz; }
+    dprintf( 2, "[pa32] patch0018 8GB sandbox/cage ask served from the holdback -> %p real=0x%llx st=0x%x\n",
+             pick, (unsigned long long)IOS_CAGE_REAL_SIZE, (unsigned)st );
+    return st;
+}
