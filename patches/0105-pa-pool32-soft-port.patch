+/* Oilpan's (cppgc's) caged heap (V8, Electron): exactly 32GB aligned to 32GB, four tries, then "Fatal process out of memory: Oilpan: CagedHeap reservation".
+ * Disassembled from the game: it then builds its heap only in the FIRST 4GB of that reservation (age table, then a bounded page allocator over base+1MB..base+4GB);
+ * the other 28GB is address space it claims and never touches. The top 64GB of the address space holds two 32GB-aligned slots; the allocator's pool (PartitionAlloc, asked
+ * first) takes [0x7800000000,0x8000000000). So the second ask gets [0x7000000000,0x8000000000-32GB), reported as 32GB, with a REAL view only over its first 4GB.
+ * Everything else that lives in that slot (the JIT pool alias, the furniture window, the emulator's band, V8's 8GB sandbox) sits above the 4GB, inside address space
+ * Oilpan claims but never uses. See patches/0018-pa-pool32-soft.md. */
+#define IOS_PA32_OILPAN_BASE 0x7000000000ULL
+#define IOS_PA32_OILPAN_REAL 0x100000000ULL
+static int ios_pa32_oilpan_hold;
+static NTSTATUS ios_pa32_cage_grant( HANDLE process, PVOID *ret, SIZE_T *size_ptr, SIZE_T req_size, ULONG type, ULONG protect )
+{
+    SIZE_T csz = IOS_CAGE_REAL_SIZE;
+    void *pick = (void *)(uintptr_t)IOS_CAGE_BASE;
+    NTSTATUS st;
+
+    if (process == NtCurrentProcess() && req_size == 0x800000000ULL && (type & MEM_RESERVE)
+        && ios_pa32_oilpan_hold && ios_pa32_soft_enabled() && find_view( (const void *)0x7800000000ULL, 0x1000 ))
+    {
+        csz = IOS_PA32_OILPAN_REAL; pick = (void *)(uintptr_t)IOS_PA32_OILPAN_BASE;
+        munmap( pick, csz );
+        ios_pa32_oilpan_hold = 0;
+        st = allocate_virtual_memory( &pick, &csz, type, protect, 0, 0, 0, 0 );
+        if (!st) { *ret = pick; *size_ptr = req_size; }   /* the real view is the first 4GB; the guest is told it has all 32GB */
+        dprintf( 2, "[pa32] patch0018 Oilpan caged-heap ask (32GB) served from the slot base -> %p real=0x%llx st=0x%x\n",
+                 pick, (unsigned long long)csz, (unsigned)st );
+        return st;
+    }
+    if (process != NtCurrentProcess() || req_size != 0x200000000ULL || !(type & MEM_RESERVE)
