+/* Porthole 0091: how much of a very large image needs a copy in the JIT pool.
+ *
+ * The pool holds a copy of the WHOLE image (code, data, resources). An installer such as Rockstar's Social-Club-Setup.exe is 125 MB of which 180 KB is code: the rest is its payload in
+ * the resource section, which nothing reaches through the pool copy (resources are read through the ordinary mapping). Two copies of it were 250 MB of an 896-1120 MB pool.
+ * Only an image of at least 16 MB whose LAST section holds the resource directory and is at least 8 MB gets a shorter copy: everything up to that section. Addresses past the end of the
+ * copy are not translated (they stay the ordinary mapping, which is where they live). MADEIRA_POOL_TRIM=0 turns it off. Returns image_size when nothing is trimmed. */
+#define IOS_POOL_TRIM_MAX 64
+static struct { uintptr_t base, trimmed_end, full_end; } ios_pool_trimmed[IOS_POOL_TRIM_MAX];
+static int ios_pool_trimmed_count;
+
+static size_t ios_pool_trim_image( const char *image_base, size_t image_size )
+{
+    static int disabled = -1;
+    const unsigned char *b = (const unsigned char *)image_base;
+    unsigned int pe_off, nsec, optsize, rsrc_rva, hdr_size, i;
+    const unsigned char *opt, *sect;
+    unsigned int last_va = 0, last_size = 0, rsrc_sec_va = 0;
+    size_t trimmed;
+
+    if (disabled < 0) { const char *e = getenv( "MADEIRA_POOL_TRIM" ); disabled = e && e[0] == '0'; }
+    if (disabled || image_size < (16u << 20)) return image_size;
+    if (*(const unsigned short *)b != 0x5A4D) return image_size;
+    pe_off = *(const unsigned int *)(b + 0x3C);
+    if (pe_off > 0x800 || *(const unsigned int *)(b + pe_off) != 0x00004550) return image_size;
+    opt = b + pe_off + 0x18;
+    if (*(const unsigned short *)opt != 0x20B) return image_size;               /* PE32+ only */
+    nsec = *(const unsigned short *)(b + pe_off + 6);
+    optsize = *(const unsigned short *)(b + pe_off + 0x14);
+    hdr_size = *(const unsigned int *)(opt + 0x3C);
+    sect = opt + optsize;
+    if (!nsec || nsec > 96 || hdr_size > 0x4000 || sect + nsec * 40 > b + hdr_size) return image_size;
+    rsrc_rva = *(const unsigned int *)(opt + 0x70 + 2 * 8);
+    {
+        static int shown;
+        if (shown < 6)
+        {
+            shown++;
+            for (i = 0; i < nsec && i < 12; i++)
+            {
+                const unsigned char *sh = sect + i * 40;
+                dprintf( 2, "[jit-pool] 0091 big image %p+0x%lx section %.8s va=0x%x size=0x%x flags=0x%x%s\n", image_base, (unsigned long)image_size, sh,
+                         *(const unsigned int *)(sh + 12), *(const unsigned int *)(sh + 8), *(const unsigned int *)(sh + 36),
+                         (rsrc_rva >= *(const unsigned int *)(sh + 12) && rsrc_rva < *(const unsigned int *)(sh + 12) + *(const unsigned int *)(sh + 8)) ? " <- resources" : "" );
+            }
+        }
+    }
+    if (!rsrc_rva) return image_size;
+    {
+        unsigned int after = 0;
+        for (i = 0; i < nsec; i++)
+        {
+            const unsigned char *sh = sect + i * 40;
+            unsigned int va = *(const unsigned int *)(sh + 12), vsz = *(const unsigned int *)(sh + 8);
+            if (rsrc_rva >= va && rsrc_rva < va + (vsz ? vsz : 1)) { rsrc_sec_va = va; last_size = vsz; }
+        }
+        if (!rsrc_sec_va || last_size < (8u << 20)) return image_size;
+        /* what follows the resource section (a .reloc) must be small and not code */
+        for (i = 0; i < nsec; i++)
+        {
+            const unsigned char *sh = sect + i * 40;
+            unsigned int va = *(const unsigned int *)(sh + 12), vsz = *(const unsigned int *)(sh + 8), fl = *(const unsigned int *)(sh + 36);
+            if (va > rsrc_sec_va)
+            {
+                if (fl & 0x20000000) return image_size;   /* executable */
+                after += vsz;
+            }
+        }
+        if (after > (4u << 20)) return image_size;
+    }
+    trimmed = ((size_t)rsrc_sec_va + 0x3fff) & ~(size_t)0x3fff;
+    if (trimmed + (8u << 20) > image_size) return image_size;
+    return trimmed;
+}
+
+static void ios_pool_trim_note( const char *image_base, size_t trimmed, size_t full )
+{
+    int i;
+    for (i = 0; i < ios_pool_trimmed_count; i++)
+        if (ios_pool_trimmed[i].base == (uintptr_t)image_base)
+        {
+            ios_pool_trimmed[i].trimmed_end = (uintptr_t)image_base + trimmed;
+            ios_pool_trimmed[i].full_end = (uintptr_t)image_base + full;
+            return;
+        }
+    if (ios_pool_trimmed_count >= IOS_POOL_TRIM_MAX) return;
+    ios_pool_trimmed[ios_pool_trimmed_count].trimmed_end = (uintptr_t)image_base + trimmed;
+    ios_pool_trimmed[ios_pool_trimmed_count].full_end = (uintptr_t)image_base + full;
+    ios_pool_trimmed[ios_pool_trimmed_count].base = (uintptr_t)image_base;
+    ios_pool_trimmed_count++;
+}
+
+static void ios_pool_trim_forget( uintptr_t base )
+{
+    int i;
+    for (i = 0; i < ios_pool_trimmed_count; i++)
+        if (ios_pool_trimmed[i].base == base)
+        {
+            ios_pool_trimmed[i].trimmed_end = ios_pool_trimmed[i].full_end = 0;   /* matches nothing */
+            return;
+        }
+}
+
+/* Is [base,base+size) in the part of a trimmed image that has no pool copy? */
+static int ios_pool_in_trimmed_tail( const void *base, size_t size )
+{
+    uintptr_t a = (uintptr_t)base;
+    int i;
+    for (i = 0; i < ios_pool_trimmed_count; i++)
+        if (a >= ios_pool_trimmed[i].trimmed_end && a + size <= ios_pool_trimmed[i].full_end && a >= ios_pool_trimmed[i].base) return 1;
+    return 0;
+}
