+/* 0.50.339 (MADEIRA_FEX_LEAN=1): the call-ret stack guard in 2 instructions instead of 5-6.
+ *
+ * The stack is allowed to move inside a 4MB window, [base+2MB, base+6MB), and is put back at base+4MB when it leaves it. The old guard loaded
+ * State.callret_sp_base, added 2MB, subtracted, shifted and tested: an ldr and four ALU instructions on every guest CALL and RET. With the stack's base
+ * 8MB-aligned (CallRetStack::InitializeThread places it there now) the window is a pattern of the address itself: bits 22:21 of sp are 01 or 10 exactly
+ * inside it, so the test is `bit21 ^ bit22` -- one eor (x ^ x>>1) and one tbnz; the (rare) reset needs no load either: the 8MB block of the stack is sp rounded down.
+ * Without MADEIRA_FEX_LEAN the old sequence is emitted unchanged. */
+bool Arm64JITCore::LeanCallRetEnabled() {
+  static const bool Enabled = [] {
+    const char* E = getenv("MADEIRA_FEX_LEAN");
+    /* 0.50.341: on unless MADEIRA_FEX_LEAN=0. */
+    const bool On = !(E && E[0] == '0');
+    LogMan::Msg::EFmt("[lean] MADEIRA_FEX_LEAN={} -> lean call/return code {}", E ? E : "(unset)", On ? "ON" : "off");
+    return On;
+  }();
+  return Enabled;
+}
+
+void Arm64JITCore::EmitCallRetGuard(ARMEmitter::XRegister Tmp) {
+  ARMEmitter::ForwardLabel l_callret_ok;
+  if (LeanCallRetEnabled()) {
+    eor(ARMEmitter::Size::i64Bit, Tmp, REG_CALLRET_SP, REG_CALLRET_SP, ARMEmitter::ShiftType::LSR, 1);
+    (void)tbnz(Tmp, 21, &l_callret_ok);
+    and_(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, REG_CALLRET_SP, ~0x7FFFFFULL);
+    orr(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, REG_CALLRET_SP, 0x400000ULL);
+    (void)Bind(&l_callret_ok);
+    return;
+  }
+  /* iOS-Madeira ml263: tightened to a 4MB window [base+2MB, base+6MB). */
+  ldr(Tmp, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.callret_sp_base));
+  add(ARMEmitter::Size::i64Bit, Tmp, Tmp, 0x200000);
+  sub(ARMEmitter::Size::i64Bit, Tmp, REG_CALLRET_SP, Tmp);
+  lsr(ARMEmitter::Size::i64Bit, Tmp, Tmp, 22);
+  (void)cbz(ARMEmitter::Size::i64Bit, Tmp, &l_callret_ok);
+  ldr(REG_CALLRET_SP, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.callret_sp_base));
+  add(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, REG_CALLRET_SP, 0x400000);
+  (void)Bind(&l_callret_ok);
+}
